@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DmcMedSync</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin-dashboard">
                    Admin Dashboard
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register-nurse">
                    Register Nurse
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="SchoolNurse, Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="nurse-station">
                    Nurse Station
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>